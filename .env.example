# Client-visible RuoYi gateway base URL. Example format: https://api.example.com
VITE_RUOYI_GATEWAY_URL=

# Client-visible application environment. Example format: development | preview | production
VITE_APP_ENV=

# Client-visible authentication mode. Example format: demo | gateway
VITE_AUTH_MODE=

# Optional server-side Vite development proxy target. The browser continues to use VITE_RUOYI_GATEWAY_URL=/gateway.
# Example format: http://ruoyi-gateway:8080
VITE_GATEWAY_PROXY_TARGET=

# Optional Supabase project URL for approved file-storage integration. Example format: https://project-ref.supabase.co
VITE_SUPABASE_URL=

# Optional Supabase anonymous key. Example format: eyJhbGciOiJIUzI1NiIs...
VITE_SUPABASE_ANON_KEY=

# Server-only OpenAI model identifier. Example format: gpt-5-mini
OPENAI_MODEL=

# Server-only OpenAI API key. Configure this only in GitHub Secrets, Vercel, or the server runtime.
OPENAI_API_KEY=

# Server-only Supabase service-role key. Configure this only in GitHub Secrets, Vercel, or the server runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only care-service MySQL JDBC URL. Example format: jdbc:mysql://db-host:3306/smart_age_care?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
CARE_DB_URL=

# Server-only care-service database username. Example format: care_service
CARE_DB_USERNAME=

# Server-only care-service database password. Configure this only in GitHub Secrets or the server runtime.
CARE_DB_PASSWORD=

# Server-only MySQL root and RuoYi application database credentials for the Codespaces integration environment.
# Generate values as hexadecimal strings so the initialization script can safely apply them.
MYSQL_ROOT_PASSWORD=
RUOYI_DB_USERNAME=ruoyi_service
RUOYI_DB_PASSWORD=

# Server-only MQTT broker URL for device-service. Example format: ssl://mqtt.example.com:8883
MQTT_BROKER_URL=

# Server-only RuoYi Gateway internal-claim verification key or certificate reference. Configure this only in GitHub Secrets or the server runtime.
PLATFORM_INTERNAL_AUTH_KEY=

# Server-only RuoYi JWT signing secret. Use at least 64 random characters; never commit its value.
RUOYI_JWT_SECRET=

# Server-only RuoYi System member-directory base URL. Example format: http://ruoyi-system:9201
RUOYI_MEMBER_DIRECTORY_URL=

# Server-only Nacos address used by RuoYi Cloud and the care service. Example format: nacos:8848
NACOS_SERVER_ADDR=

# Server-only Nacos username. Example format: nacos
NACOS_USERNAME=

# Server-only Nacos password. Configure this only in GitHub Secrets or the server runtime.
NACOS_PASSWORD=

# Server-only Nacos config-database credentials and Nacos auth secrets. Configure only in GitHub Secrets or the server runtime.
NACOS_DB_USERNAME=
NACOS_DB_PASSWORD=
NACOS_AUTH_ENABLED=true
NACOS_AUTH_TOKEN_SECRET=
NACOS_SERVER_IDENTITY_KEY=
NACOS_SERVER_IDENTITY_VALUE=

# Server-only notification overdue scan interval in milliseconds. Example format: 60000
NOTIFICATION_OVERDUE_SCAN_MS=

# Server-only audit retention period in days. Example format: 2555
AUDIT_RETENTION_DAYS=

# Server-only audit retention scan interval in milliseconds. Example format: 86400000
AUDIT_RETENTION_SCAN_MS=
