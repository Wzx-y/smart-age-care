# Copy this file to .env.codespaces in GitHub Codespaces. Do not commit the copy.
# Values containing shell or SQL metacharacters are rejected by the bootstrap script for the two database passwords.
MYSQL_ROOT_PASSWORD=
CARE_DB_PASSWORD=

# Nacos runtime credentials. Set these in Codespaces Secrets or the ignored .env.codespaces file.
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_AUTH_TOKEN_SECRET=
NACOS_SERVER_IDENTITY_KEY=
NACOS_SERVER_IDENTITY_VALUE=

RUOYI_JWT_SECRET=
PLATFORM_INTERNAL_AUTH_KEY=
